{
  "name": "zaru-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API de Zaru Ecosystem (Node + Express)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node src/index.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integracion": "vitest run tests/integration"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^2.1.9"
  }
}
