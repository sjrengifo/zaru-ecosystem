{
  "name": "zaru-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API de Zaru Ecosystem (Node + Express)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node src/index.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integracion": "vitest run tests/integration",
    "lint:openapi": "redocly lint openapi/openapi.yaml",
    "cifrar:correos": "node --env-file=.env scripts/cifrar-correos.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "helmet": "^8.3.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.22",
    "supertest": "^7.3.1",
    "vitest": "^2.1.9"
  }
}
