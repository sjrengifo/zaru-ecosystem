# Copia este archivo como ".env" y llena los valores. ".env" está en .gitignore: nunca se sube a GitHub.
# En Render, estas mismas variables se configuran en Environment del servicio zaru-api (HU-50 CA3).

PORT=4000

SUPABASE_URL=https://djutvsulfduzuylvaten.supabase.co
# SECRETA: clave secreta de Supabase (Project Settings → API Keys → secret / service_role).
# Nunca la pongas en el frontend ni en el código.
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-clave-secreta

# SECRETA: clave de 32 bytes para cifrar datos personales a nivel de campo (HU-50).
# Genérala una vez por ambiente con:  openssl rand -base64 32
# Si se pierde, los correos cifrados con ella no se pueden recuperar: guárdala también en el gestor del equipo.
ZARU_CLAVE_CIFRADO=

# Dirección del frontend (para permitir sus peticiones / CORS). En producción debe ser https://
FRONTEND_URL=http://localhost:5173

# HU-46: correos al cliente (ingreso del vehículo y "listo para recoger").
# consola = no envía nada, solo escribe el mensaje en la terminal (desarrollo y pruebas).
# smtp    = cualquier servidor SMTP (Gmail con contraseña de aplicación, Mailtrap, Brevo…).
# resend  = API de Resend (plan gratuito); exige RESEND_API_KEY y un remitente de un dominio verificado.
CORREO_PROVEEDOR=consola
CORREO_REMITENTE=Zaru <notificaciones@zaru.app>
# Solo con CORREO_PROVEEDOR=resend (SECRETA):
RESEND_API_KEY=
# Solo con CORREO_PROVEEDOR=smtp (SMTP_CLAVE es SECRETA):
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=

# HU-34 y HU-33: cola de notificaciones con reintentos (1, 2 y 4 min) y canal alterno.
# on = el backend procesa la cola en segundo plano; off = solo la crea (desarrollo sin envíos).
NOTIFICACIONES_WORKER=on
# Esperas entre reintentos en milisegundos (por defecto 1, 2 y 4 minutos).
# NOTIFICACIONES_ESPERAS_MS=60000,120000,240000
# consola = escribe el SMS en el log; twilio = API real; deshabilitado = sin canal alterno.
SMS_PROVEEDOR=consola
# Solo con SMS_PROVEEDOR=twilio (SECRETAS):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# HU-33 CA4: confirmación de entrega de los proveedores (webhooks firmados). Sin ellas los webhooks
# responden 503 y el resto funciona igual.
# Secreto del webhook de Resend (empieza por whsec_, SECRETO):
RESEND_WEBHOOK_SECRET=
# Dirección pública de la API, sin /api/v1 (Twilio la usa para avisar la entrega del SMS):
API_URL_PUBLICA=
# HU-40 conectará Web Push; mientras tanto el canal push pasa directo al canal alterno.
# PUSH_PROVEEDOR=
# HU-23/HU-24: clave opcional de 32 bytes para firmar el pase del historial del cliente.
# Si se omite, se usa ZARU_CLAVE_CIFRADO.
# ZARU_CLAVE_PASE=
