# Copia este archivo como ".env" y llena los valores. ".env" está en .gitignore: nunca se sube a GitHub.
# En Render, estas mismas variables se configuran en Environment del servicio zaru-api (HU-50 CA3).

PORT=4000

SUPABASE_URL=https://djutvsulfduzuylvaten.supabase.co
# SECRETA: clave secreta de Supabase (Project Settings → API Keys → secret / service_role).
# Nunca la pongas en el frontend ni en el código.
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-clave-secreta

# SECRETA: clave de 32 bytes para cifrar datos personales a nivel de campo (HU-50).
# Genérala una vez por ambiente con:  openssl rand -base64 32
# Si se pierde, los correos cifrados con ella no se pueden recuperar: guárdala también en el gestor del equipo.
ZARU_CLAVE_CIFRADO=

# Dirección del frontend (para permitir sus peticiones / CORS). En producción debe ser https://
FRONTEND_URL=http://localhost:5173
