# Copia este archivo como ".env" y llena los valores.
# Los encuentras en Supabase → Project Settings → API.

PORT=4000

SUPABASE_URL=https://xxxxxxxx.supabase.co
# ⚠️ SECRETA: nunca la pongas en el frontend ni la subas a GitHub.
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-service-role-key

# Dirección del frontend (para permitir sus peticiones / CORS).
FRONTEND_URL=http://localhost:5173
